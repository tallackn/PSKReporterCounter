// The App Store and TestFlight share the same versioned archive.
MARKETING_VERSION = 1.2.1
CURRENT_PROJECT_VERSION = 13
DEVELOPMENT_TEAM = 33LJMNUTSN
PRODUCT_BUNDLE_IDENTIFIER = com.tallackn.PSKReporterCounter
MACOSX_DEPLOYMENT_TARGET = 13.0
ARCHS = arm64
CODE_SIGN_STYLE = Automatic
ENABLE_APP_SANDBOX = YES
ENABLE_OUTGOING_NETWORK_CONNECTIONS = YES
ENABLE_HARDENED_RUNTIME = YES
CODE_SIGN_ENTITLEMENTS = Resources/PSKReporterCounter.entitlements
ENABLE_USER_SCRIPT_SANDBOXING = YES
SWIFT_VERSION = 5.0
SWIFT_STRICT_CONCURRENCY = complete
GENERATE_INFOPLIST_FILE = NO
INFOPLIST_FILE = Configuration/Info.plist
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks
COMBINE_HIDPI_IMAGES = YES
EXECUTABLE_NAME = PSKReporterCounter
PRODUCT_NAME = PSK Reporter Counter
SKIP_INSTALL = NO
